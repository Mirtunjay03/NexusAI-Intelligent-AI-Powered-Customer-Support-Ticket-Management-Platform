MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nexusai
CORS_ORIGINS=http://localhost:5173
APP_ENV=development
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional task-specific models; unset values use LLM_MODEL.
LLM_CLASSIFICATION_MODEL=
LLM_RESPONSE_MODEL=
LLM_SUMMARY_MODEL=
LLM_CHAT_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=25
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Set only after creating the Atlas Vector Search index described in README.md.
VECTOR_SEARCH_INDEX_NAME=
KNOWLEDGE_TENANT_ID=default
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=180
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SCORE=0.65
KNOWLEDGE_MAX_PDF_BYTES=10485760
KNOWLEDGE_MAX_EXTRACTED_CHARS=500000
